rules_version = '2';
service firebase.storage { match /b/{bucket}/o { match /published-sites/{uid}/{projectId}/{allPaths=**} { allow read,write: if request.auth != null && request.auth.uid == uid; } match /project-assets/{uid}/{projectId}/{allPaths=**} { allow read,write: if request.auth != null && request.auth.uid == uid; } match /{allPaths=**} { allow read,write: if false; } } }
